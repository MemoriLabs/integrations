{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/python.sh",
              "${CLAUDE_PLUGIN_ROOT}/hooks/session_start.py"
            ],
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/python.sh",
              "${CLAUDE_PLUGIN_ROOT}/hooks/stop.py"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/python.sh",
              "${CLAUDE_PLUGIN_ROOT}/hooks/user_prompt_submit.py"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  }
}
